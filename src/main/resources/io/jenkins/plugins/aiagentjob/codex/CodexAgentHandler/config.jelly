<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:optionalBlock inline="true" title="Use custom Codex config.toml" field="customConfigEnabled">
    <f:entry title="Custom Codex config.toml" field="customConfigToml">
      <f:textarea />
    </f:entry>
  </f:optionalBlock>

  <f:advanced>
    <f:entry title="Additional Codex global args" field="additionalGlobalArgs">
      <f:textbox />
    </f:entry>
    <f:entry title="Additional Codex exec args" field="additionalExecArgs">
      <f:textbox />
    </f:entry>
  </f:advanced>
</j:jelly>
